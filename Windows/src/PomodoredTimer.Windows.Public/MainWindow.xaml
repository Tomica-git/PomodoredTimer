<Window x:Class="PomodoredTimer.Windows.Public.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PomodoredTimer.Windows.Public.Controls"
        Title="Pomodored Timer — Windows Public Candidate"
        Width="940"
        Height="700"
        MinWidth="320"
        MinHeight="300"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SettingsColumn" Width="290" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="POMODORED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
                    <TextBlock x:Name="PhaseText" Text="集中 · SET 1" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="WINDOWS PUBLIC CANDIDATE" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="記録" Click="History_Click" />
                    <Button x:Name="PinButton" Content="最前面" Click="Pin_Click" />
                    <Button x:Name="CompactButton" Content="縮小" Click="Compact_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:TimerDial x:Name="Dial"
                                    Grid.Column="1"
                                    Width="300"
                                    Height="300"
                                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock x:Name="RemainingText" Text="25:00" FontSize="64" FontWeight="Medium" />
                    <TextBlock x:Name="SpeedText" Text="赤 ×2.0　黒 1分/1目盛" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="SoundText" Text="針音オン" FontSize="12" Margin="0,8,0,0" Foreground="{StaticResource TealBrush}" />
                    <TextBlock x:Name="CompletionText" FontSize="12" Margin="0,8,0,0" Foreground="{StaticResource CoralBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton"
                        Grid.Column="0"
                        Height="48"
                        Margin="0,0,10,0"
                        Background="{StaticResource TealBrush}"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Content="開始"
                        Click="Primary_Click" />
                <Button Grid.Column="1" Width="80" Content="リセット" Click="Reset_Click" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsPanel"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource PanelBrush}">
            <StackPanel Margin="20">
                <TextBlock Text="時間を整える" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="集中" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="−" Tag="focus:-1" Click="Duration_Click" />
                        <TextBlock x:Name="FocusMinutesText" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        <Button Content="＋" Tag="focus:1" Click="Duration_Click" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="短い休憩" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="−" Tag="short:-1" Click="Duration_Click" />
                        <TextBlock x:Name="ShortMinutesText" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        <Button Content="＋" Tag="short:1" Click="Duration_Click" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="長い休憩" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="−" Tag="long:-1" Click="Duration_Click" />
                        <TextBlock x:Name="LongMinutesText" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        <Button Content="＋" Tag="long:1" Click="Duration_Click" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,14" />
                <TextBlock Text="赤い針の速さ" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="通常" Tag="1" Click="Speed_Click" />
                    <Button Content="×1.5" Tag="1.5" Click="Speed_Click" />
                    <Button Content="×2" Tag="2" Click="Speed_Click" />
                    <Button Content="×3" Tag="3" Click="Speed_Click" />
                    <Button Content="×4" Tag="4" Click="Speed_Click" />
                    <Button Content="×5" Tag="5" Click="Speed_Click" />
                </WrapPanel>

                <Separator Margin="0,14" />
                <CheckBox x:Name="AutoSessionCheck" Content="自動で次のセッションへ移行" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                <TextBlock Text="集中と休憩を自動で開始します。" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="3,0,0,8" />
                <CheckBox x:Name="CompletionSoundCheck" Content="終了音" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                <CheckBox x:Name="NeedleMuteCheck" Content="針音をミュート" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                <CheckBox x:Name="ReduceMotionCheck" Content="動きを減らす" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />
                <CheckBox x:Name="TopmostCheck" Content="常に手前" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" />

                <Separator Margin="0,14" />
                <TextBlock Text="公開版について" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="個人版のメディア再生や他OSの記録移行・同期は含みません。記録はWindows公開版専用の保存領域だけに保存します。"
                           TextWrapping="Wrap"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
