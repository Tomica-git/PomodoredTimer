<Application x:Class="PomodoredTimer.Windows.Public.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#DCEDE4" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F0F8F2" />
        <SolidColorBrush x:Key="InkBrush" Color="#143333" />
        <SolidColorBrush x:Key="MutedBrush" Color="#506B66" />
        <SolidColorBrush x:Key="TealBrush" Color="#0D5C5C" />
        <SolidColorBrush x:Key="CoralBrush" Color="#E84F45" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="3,6" />
        </Style>
    </Application.Resources>
</Application>
