<Window x:Class="PomodoredTimer.Windows.Public.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PomodoredTimer.Windows.Public.Controls"
        Title="作業と休憩の記録 — Windows Public Candidate"
        Width="900"
        Height="620"
        MinWidth="620"
        MinHeight="420"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="POMODORO TRACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TealBrush}" />
                <TextBlock Text="作業と休憩の記録" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="日" Tag="day" Click="Period_Click" />
                <Button Content="週" Tag="week" Click="Period_Click" />
                <Button Content="月" Tag="month" Click="Period_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="ポモドーロ作業" FontSize="11" /><TextBlock x:Name="FocusSummaryText" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="4,0">
                <StackPanel><TextBlock Text="休憩" FontSize="11" /><TextBlock x:Name="BreakSummaryText" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="完了セット" FontSize="11" /><TextBlock x:Name="SetsSummaryText" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Button Content="‹" HorizontalAlignment="Left" Width="44" Click="Previous_Click" />
                <TextBlock x:Name="RangeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button Content="›" HorizontalAlignment="Right" Width="44" Click="Next_Click" />
            </Grid>
            <controls:HistoryChart x:Name="Chart" Grid.Row="1" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,12,0,0">
            <Rectangle Width="12" Height="8" Fill="#E84F45" Margin="0,0,5,0" /><TextBlock Text="集中" FontSize="10" Margin="0,0,14,0" />
            <Rectangle Width="12" Height="8" Fill="#337AB8" Margin="0,0,5,0" /><TextBlock Text="休憩" FontSize="10" />
        </StackPanel>
    </Grid>
</Window>
